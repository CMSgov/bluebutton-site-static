---
import LogoBlueButton from '#assets/images/logo-bluebutton.svg'
import IconClose from '@uswds/uswds/img/usa-icons/close.svg'
import Link from './link.astro'
import { getCollection } from 'astro:content'
import { getProductionCollection } from '../utils/collections'

const docsnavLinks = await getCollection('static', ({ id }) => id.startsWith('api-documentation/'))
const guidesnavLinks = await getCollection('static', ({ id }) => id.startsWith('guides/'))
const datanavLinks = await getCollection('static', ({ id }) => id.startsWith('data/'))
const quickStartLinks = await getCollection('static', ({ id }) => id.startsWith('quickstart/'))
const productionLinks = await getProductionCollection()

const isActive = (path: string) => Astro.url.pathname.startsWith(path)
---

<div class="position-sticky top-0 bg-white shadow-1 z-500">
  <div class="usa-overlay"></div>
  <header class="usa-header usa-header--basic">
    <div class="usa-nav-container">
      <div class="usa-navbar">
        <div class="usa-logo">
          <Link
            to="/"
            data-tealium="navigation"
            class="display-flex flex-align-center height-6 maxw-card-lg"
            style="gap: 0.5rem;"
          >
            <LogoBlueButton aria-hidden class="width-5 height-5" />
            <span class="font-sans-md text-bold text-black text-balance line-height-sans-2">CMS Blue Button API</span>
          </Link>
        </div>
        <button type="button" class="usa-menu-btn">Menu</button>
      </div>
      <nav aria-label="Primary navigation" class="usa-nav">
        <button type="button" class="usa-nav__close">
          <IconClose aria-label="close" />
        </button>
        <ul class="usa-nav__primary usa-accordion">
          <li class="usa-nav__primary-item">
            <button
              type="button"
              class:list={['usa-accordion__button usa-nav__link', isActive('/quickstart') ? 'usa-current' : null]}
              aria-expanded="false"
              aria-controls="basic-nav-section-five"
            >
              <span>Quickstart</span>
            </button>
            <ul id="basic-nav-section-five" class="usa-nav__submenu" hidden>
              <li class="usa-nav__submenu-item">
                <Link to="/[...slug]" params={{ slug: 'quickstart' }} data-tealium="main_nav">Overview</Link>
              </li>
              {
                quickStartLinks.map((link) => (
                  <li class="usa-nav__submenu-item">
                    <Link to="/[...slug]" params={{ slug: link.id }} data-tealium="main_nav">
                      {link.data.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="usa-nav__primary-item">
            <button
              type="button"
              class:list={[
                'usa-accordion__button usa-nav__link',
                isActive('/api-documentation') ? 'usa-current' : null,
              ]}
              aria-expanded="false"
              aria-controls="basic-nav-section-one"
            >
              <span>API Documentation</span>
            </button>
            <ul id="basic-nav-section-one" class="usa-nav__submenu" hidden>
              <li class="usa-nav__submenu-item">
                <Link to="/[...slug]" params={{ slug: 'api-documentation' }} data-tealium="main_nav">Get Started</Link>
              </li>
              {
                docsnavLinks.map((link) => (
                  <li class="usa-nav__submenu-item">
                    <Link to="/[...slug]" params={{ slug: link.id }} data-tealium="main_nav">
                      {link.data.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="usa-nav__primary-item">
            <button
              type="button"
              class:list={['usa-accordion__button usa-nav__link', isActive('/guides') ? 'usa-current' : null]}
              aria-expanded="false"
              aria-controls="basic-nav-section-three"
            >
              <span>Guides</span>
            </button>
            <ul id="basic-nav-section-three" class="usa-nav__submenu" hidden>
              <li class="usa-nav__submenu-item">
                <Link to="/[...slug]" params={{ slug: 'guides' }} data-tealium="main_nav">Get Started</Link>
              </li>
              {
                guidesnavLinks.map((link) => (
                  <li class="usa-nav__submenu-item">
                    <Link to="/[...slug]" params={{ slug: link.id }} data-tealium="main_nav">
                      {link.data.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="usa-nav__primary-item">
            <button
              type="button"
              class:list={['usa-accordion__button usa-nav__link', isActive('/data') ? 'usa-current' : null]}
              aria-expanded="false"
              aria-controls="basic-nav-section-two"
            >
              <span>Data</span>
            </button>
            <ul id="basic-nav-section-two" class="usa-nav__submenu" hidden>
              <li class="usa-nav__submenu-item">
                <Link to="/[...slug]" params={{ slug: 'data' }} data-tealium="main_nav">Overview</Link>
              </li>
              {
                datanavLinks.map((link) => (
                  <li class="usa-nav__submenu-item">
                    <Link to="/[...slug]" params={{ slug: link.id }} data-tealium="main_nav">
                      {link.data.title}
                    </Link>
                  </li>
                ))
              }
              <li class="usa-nav__submenu-item">
                <Link to="/data-dictionary" data-tealium="main_nav">Data Dictionary</Link>
              </li>
            </ul>
          </li>
          <li class="usa-nav__primary-item">
            <button
              type="button"
              class:list={['usa-accordion__button usa-nav__link', isActive('/production') ? 'usa-current' : null]}
              aria-expanded="false"
              aria-controls="basic-nav-section-four"
            >
              <span>Production</span>
            </button>
            <ul id="basic-nav-section-four" class="usa-nav__submenu" hidden>
              <li class="usa-nav__submenu-item">
                <Link to="/[...slug]" params={{ slug: 'production' }} data-tealium="main_nav">Overview</Link>
              </li>
              {
                productionLinks.map((link) => (
                  <li class="usa-nav__submenu-item">
                    <Link to="/[...slug]" params={{ slug: link.id }} data-tealium="main_nav">
                      {link.data.title}
                    </Link>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
        <div class="desktop:padding-left-1 margin-top-4 desktop:margin-top-0">
          <Link
            href="https://sandbox.bluebutton.cms.gov/v1/accounts/login"
            variant="primary"
            data-tealium="navigation"
            class="width-full desktop:width-auto">Sandbox</Link
          >
        </div>
      </nav>
    </div>
  </header>
</div>
