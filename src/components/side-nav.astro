---
import { $path } from 'astro-typesafe-routes/path'

import Swagger from '#assets/images/swagger.svg'
import Github from '@uswds/uswds/img/usa-icons/github.svg'

import Icon from './icon.astro'
import { getCollection } from 'astro:content'
import Link from './link.astro'

const { pathname } = Astro.url

const quickstartLinks = await getCollection('static', ({ id }) => id.startsWith('quickstart/'))
const docsLinks = await getCollection('static', ({ id }) => id.startsWith('api-documentation/'))
const dataLinks = await getCollection('static', ({ id }) => id.startsWith('data/'))
const guideLinks = await getCollection('static', ({ id }) => id.startsWith('guides/'))

const isActive = (path: string) => path === pathname
---

<div
  class="display-none position-sticky tablet:display-block tablet:grid-col-auto overflow-y-auto overflow-x-hidden padding-top-5 desktop:padding-top-7 padding-right-05 padding-bottom-6 padding-left-05 margin-left-neg-05"
  style="top: 4rem; max-height: calc(100vh - 4.5rem);"
>
  <div class="width-card-lg">
    <nav aria-label="Side navigation">
      <ul class="usa-sidenav">
        <li class="usa-sidenav__item">
          <Link
            to="/[...slug]"
            params={{ slug: 'quickstart' }}
            class={isActive($path({ to: '/[...slug]', params: { slug: 'quickstart' } })) ? 'usa-current' : null}
            data-tealium="left-rail">Quickstart</Link
          >
        </li>
        <ul class="usa-sidenav__sublist">
          {
            quickstartLinks.map((link) => (
              <li class="usa-sidenav__item">
                <Link
                  to="/[...slug]"
                  params={{ slug: link.id }}
                  class={isActive($path({ to: '/[...slug]', params: { slug: link.id } })) ? 'usa-current' : null}
                  data-tealium="left-rail"
                >
                  {link.data.title}
                </Link>
              </li>
            ))
          }
        </ul>
        <li class="usa-sidenav__item">
          <Link
            to="/[...slug]"
            params={{ slug: 'api-documentation' }}
            class={isActive($path({ to: '/[...slug]', params: { slug: 'api-documentation' } })) ? 'usa-current' : null}
            data-tealium="left-rail">API Documentation</Link
          >
        </li>
        <ul class="usa-sidenav__sublist">
          {
            docsLinks.map((link) => (
              <li class="usa-sidenav__item">
                <Link
                  to="/[...slug]"
                  params={{ slug: link.id }}
                  class={isActive($path({ to: '/[...slug]', params: { slug: link.id } })) ? 'usa-current' : null}
                  data-tealium="left-rail"
                >
                  {link.data.title}
                </Link>
              </li>
            ))
          }
        </ul>
        <li class="usa-sidenav__item">
          <Link
            to="/[...slug]"
            params={{ slug: 'guide' }}
            class={isActive($path({ to: '/[...slug]', params: { slug: 'guide' } })) ? 'usa-current' : null}
            data-tealium="left-rail">Guides</Link
          >
        </li>
        <ul class="usa-sidenav__sublist">
          {
            guideLinks.map((link) => (
              <li class="usa-sidenav__item">
                <Link
                  to="/[...slug]"
                  params={{ slug: link.id }}
                  class={isActive($path({ to: '/[...slug]', params: { slug: link.id } })) ? 'usa-current' : null}
                  data-tealium="left-rail"
                >
                  {link.data.title}
                </Link>
              </li>
            ))
          }
        </ul>
        <li class="usa-sidenav__item">
          <Link
            to="/[...slug]"
            params={{ slug: 'data' }}
            class={isActive($path({ to: '/[...slug]', params: { slug: 'data' } })) ? 'usa-current' : null}
            data-tealium="left-rail">Data Overview</Link
          >
        </li>
        <ul class="usa-sidenav__sublist">
          {
            dataLinks.map((link) => (
              <li class="usa-sidenav__item">
                <Link
                  to="/[...slug]"
                  params={{ slug: link.id }}
                  class={isActive($path({ to: '/[...slug]', params: { slug: link.id } })) ? 'usa-current' : null}
                  data-tealium="left-rail"
                >
                  {link.data.title}
                </Link>
              </li>
            ))
          }
          <li class="usa-sidenav__item">
            <Link
              to="/data-dictionary"
              class={isActive($path({ to: '/data-dictionary' })) ? 'usa-current' : null}
              data-tealium="left-rail"
            >
              Data Dictionary
            </Link>
          </li>
        </ul>
        <li class="usa-sidenav__item">
          <Link href="https://github.com/CMSgov/bluebutton-web-server" showIcon={false} data-tealium="left-rail">
            <span class="display-flex flex-align-center">
              <span class="padding-right-1">GitHub</span>
              <Icon icon={Github} size={3} />
            </span>
          </Link>
        </li>
        <li class="usa-sidenav__item">
          <Link href="https://sandbox.bluebutton.cms.gov/docs/openapi" showIcon={false} data-tealium="left-rail">
            <span class="display-flex flex-align-center">
              <span class="padding-right-1">Swagger</span>
              <Icon icon={Swagger} size={3} />
            </span>
          </Link>
        </li>
      </ul>
    </nav>
  </div>
</div>
