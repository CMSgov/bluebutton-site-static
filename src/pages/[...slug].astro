---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import { createRoute } from 'astro-typesafe-routes/create-route'

import DocsLayout from '#layouts/docs-layout.astro'
import BaseLayout from '#layouts/base-layout.astro'

import OverflowTable from '#components/overflow-table.astro'
import AccordionItem from '#components/accordion/accordion-item.astro'
import AccordionList from '#components/accordion/accordion-list.astro'
import Alert from '#components/alert.astro'
import IconList from '#components/icon-list.astro'
import Link from '#components/link.astro'
import ProcessListItem from '#components/process-list/process-list-item.astro'
import ProcessList from '#components/process-list/process-list.astro'

export const Route = createRoute({
  routeId: '/[...slug]',
})

export type Props = {
  post: CollectionEntry<'static'>
}

export const getStaticPaths = Route.createGetStaticPaths<Props>(async () => {
  const fields = await getCollection('static')
  return fields.map((field) => ({
    params: { slug: field.id },
    props: { post: field },
  }))
})

const { post } = Astro.props

const { Content, headings } = await render(post)
---

<BaseLayout title={post.data.seo?.title || post.data.title} description={post.data.seo?.description || ''}>
  <DocsLayout headings={headings}>
    <div class="margin-bottom-4">
      <h1>{post.data.title}</h1>
    </div>
    <div class="usa-prose">
      <Content
        components={{
          a: Link,
          table: OverflowTable,
          Link,
          ProcessList,
          ProcessListItem,
          Alert,
          Image,
          IconList,
          AccordionList,
          AccordionItem,
        }}
      />
    </div>
  </DocsLayout>
</BaseLayout>
