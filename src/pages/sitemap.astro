---
import BaseLayout from '#layouts/base-layout.astro'
import DocsLayout from '#layouts/docs-layout.astro'
import { $path } from 'astro-typesafe-routes/path'
import Link from '#components/link.astro'

const sitemapLinks = [
  {
    label: 'Home',
    href: $path({ to: '/', trailingSlash: true }),
  },
  {
    label: 'Use Cases',
    href: $path({ to: '/[...slug]', params: { slug: 'use-cases' }, trailingSlash: true }),
  },
  {
    label: 'API Documentation',
    href: $path({ to: '/[...slug]', params: { slug: 'api-documentation' }, trailingSlash: true }),
    // children: docsnavLinks,
    children: [],
  },
  {
    label: 'Data Overview',
    href: $path({ to: '/[...slug]', params: { slug: 'data' }, trailingSlash: true }),
    // children: datanavLinks,
    children: [],
  },
  // {
  //   label: 'Production Access',
  //   href: $path({ to: '/production-access', trailingSlash: true }),
  // },
  {
    label: 'Support',
    href: $path({ to: '/support', trailingSlash: true }),
  },
]
---

<BaseLayout
  title="Sitemap"
  description="Navigate the Blue Button website with our sitemap, containing all the pages including API documentation, data resources, production access process, and support options"
>
  <DocsLayout showSideNav={false}>
    <div class="margin-bottom-4">
      <h1>Sitemap</h1>
    </div>
    <div class="usa-prose">
      <ul>
        {
          sitemapLinks.map((link) => (
            <li>
              <Link href={link.href}>{link.label}</Link>

              {link?.children ? (
                <ul>
                  {/* {link.children.map((child) => (
                    <li>
                      <Link href={child.href}>{child.label}</Link>
                    </li>
                  ))} */}
                </ul>
              ) : null}
            </li>
          ))
        }
      </ul>
    </div>
  </DocsLayout>
</BaseLayout>
